# =============================================================================
# BridgePoint website — Apache configuration (copied to dist/ on build)
# =============================================================================

Options -Indexes -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://www.bridgepoint.pt%{REQUEST_URI} [L,R=301]

  # 2) Canonical domain: bridgepoint.pt -> www.bridgepoint.pt
  #    (if you prefer the domain without "www", invert this rule and update VITE_SITE_URL)
  RewriteCond %{HTTP_HOST} ^bridgepoint\.pt$ [NC]
  RewriteRule ^ https://www.bridgepoint.pt%{REQUEST_URI} [L,R=301]

  # 3) Old WordPress URLs -> new site (keeps existing links and search results working).
  #    "/" then sends the visitor to /pt/ or /en/ (saved choice or browser language).
  RewriteRule ^wordpress/?$ / [L,R=301]
  RewriteRule ^wordpress/(.*)$ / [L,R=301]

  # 4) Language URLs: /pt and /en -> /pt/ and /en/ (home page), and no trailing slash on
  #    inner pages (/pt/about/ -> /pt/about), so every page has a single address.
  RewriteRule ^(pt|en)$ /$1/ [L,R=301]
  RewriteRule ^((?:pt|en)/.+)/$ /$1 [L,R=301]

  # 5) Pages prerendered at build time (scripts/prerender.mjs): /pt/about -> /pt/about.html,
  #    /pt/news/<slug> -> /pt/news/<slug>.html. /pt/ and /en/ use pt/index.html and en/index.html.
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^((?:pt|en)/.+)$ $1.html [L]

  # 6) Single-page app fallback: index.html for any other route that is not a real file
  #    (/, old links without a language, /admin, articles published after the last build).
  #    Missing static files (e.g. /img/missing.png) are excluded so they return a real 404.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.(js|css|map|png|jpe?g|webp|gif|svg|ico|mp4|woff2?|xml|txt|pdf|json)$ [NC]
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Security headers
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.tile.openstreetmap.org https://tile.openstreetmap.org https://*.supabase.co https://www.google-analytics.com https://www.googletagmanager.com; font-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; frame-src https://challenges.cloudflare.com; media-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"

  # Caching: hashed build assets forever, HTML never
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|jpe?g|png|gif|svg|ico|mp4)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml application/xml
</IfModule>

# Never serve environment or source files if they end up on the server by mistake
<FilesMatch "^(\.env.*|.*\.sql|.*\.md|package(-lock)?\.json)$">
  Require all denied
</FilesMatch>
